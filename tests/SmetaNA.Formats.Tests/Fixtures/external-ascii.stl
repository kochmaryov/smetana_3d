solid external sample
  facet normal 0 0 1
    outer loop
      vertex 0 0 0
      vertex 1.5e1 0 0
      vertex 0 1.5e1 0
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex 0 0 0
      vertex 0 1.5e1 0
      vertex -1.5e1 1.5e1 0
    endloop
  endfacet
endsolid external sample
