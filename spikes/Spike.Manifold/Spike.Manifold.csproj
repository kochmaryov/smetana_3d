<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Spike.Manifold</RootNamespace>
  </PropertyGroup>

  <!-- build\: загрузки и нативная сборка (CMake/исходники Manifold) — не часть managed-проекта. -->
  <ItemGroup>
    <Compile Remove="build\**\*" />
    <None Remove="build\**\*" />
    <Content Remove="build\**\*" />
    <EmbeddedResource Remove="build\**\*" />
  </ItemGroup>

  <!-- Нативные библиотеки Manifold (manifoldc.dll + manifold.dll) кладутся рядом с exe. -->
  <ItemGroup>
    <None Update="native\win-x64\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
