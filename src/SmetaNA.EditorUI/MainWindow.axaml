<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmetaNA.EditorUI.ViewModels"
        xmlns:views="using:SmetaNA.EditorUI.Views"
        xmlns:vcb="using:SmetaNA.EditorUI.Vcb"
        xmlns:printvolume="using:SmetaNA.EditorUI.PrintVolume"
        xmlns:toolpalette="using:SmetaNA.EditorUI.ToolPalette"
        x:Class="SmetaNA.EditorUI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Strings.AppTitle}"
        Width="1280"
        Height="800"
        KeyDown="OnWindowKeyDown">
  <DockPanel>
    <!-- Меню: быстрый доступ к основным командам (progressive disclosure) -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="{Binding Strings.MenuFile}">
        <MenuItem Header="{Binding Strings.ProjectNew}" Command="{Binding NewProjectCommand}" />
        <MenuItem Header="{Binding Strings.LicenseOpen}" Command="{Binding OpenLicenseCommand}" />
      </MenuItem>
      <MenuItem Header="{Binding Strings.MenuEdit}">
        <MenuItem Header="{Binding Strings.EditUndo}"
                  Command="{Binding UndoCommand}"
                  ToolTip.Tip="{Binding UndoHint}" />
        <MenuItem Header="{Binding Strings.EditRedo}"
                  Command="{Binding RedoCommand}"
                  ToolTip.Tip="{Binding RedoHint}" />
      </MenuItem>
      <MenuItem Header="{Binding Strings.MenuView}">
        <MenuItem Header="{Binding Strings.CommandToggleTheme}" Command="{Binding ThemeToggleCommand}" />
        <MenuItem Header="{Binding Strings.ModeLabel}" Command="{Binding ToggleModeCommand}" />
        <MenuItem Header="{Binding ToolLayoutMenuLabel}" Command="{Binding OpenToolLayoutCommand}" />
      </MenuItem>
      <MenuItem Header="{Binding Strings.MenuHelp}">
        <MenuItem Header="{Binding Strings.TutorialStart}" Command="{Binding Tutorial.StartCommand}" />
        <MenuItem Header="{Binding Strings.LicenseOpen}" Command="{Binding OpenLicenseCommand}" />
      </MenuItem>
    </Menu>

    <!-- Быстрый доступ: файловые команды и переключатели (инструменты — в палитре слева) -->
    <Border DockPanel.Dock="Top"
            BorderBrush="{DynamicResource ThemeBorderMidBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,4">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="{Binding Strings.ProjectNew}"
                  Command="{Binding NewProjectCommand}" />
          <Button Content="{Binding Strings.EditUndo}"
                  Command="{Binding UndoCommand}"
                  ToolTip.Tip="{Binding UndoHint}" />
          <Button Content="{Binding Strings.EditRedo}"
                  Command="{Binding RedoCommand}"
                  ToolTip.Tip="{Binding RedoHint}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <Button Content="{Binding ModeToggleLabel}"
                  Command="{Binding ToggleModeCommand}"
                  ToolTip.Tip="{Binding Strings.ModeNoviceHint}" />
          <Button Content="{Binding ThemeToggleLabel}"
                  Command="{Binding ThemeToggleCommand}" />
          <Button Content="{Binding Strings.CommandToggleLanguage}"
                  Command="{Binding ToggleLanguageCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Строка значений (VCB) и статус -->
    <Border DockPanel.Dock="Bottom"
            BorderBrush="{DynamicResource ThemeBorderMidBrush}"
            BorderThickness="0,1,0,0"
            Padding="8">
      <Grid ColumnDefinitions="Auto,*">
        <vcb:VcbControl Prompt="{Binding VcbPrompt}"
                        PlaceholderText="{Binding Strings.VcbWatermark}"
                        Kind="{Binding VcbKind}"
                        Unit="{Binding SceneUnit}"
                        IsEnabled="{Binding HasVcb}"
                        Committed="OnVcbCommitted" />
        <TextBlock Grid.Column="1"
                   Text="{Binding StatusText}"
                   VerticalAlignment="Center"
                   Margin="16,0,0,0"
                   TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <!-- Палитра инструментов (волна 2: контрол трека B поверх реестра и раскладки трека C) -->
    <toolpalette:ToolPaletteControl DockPanel.Dock="Left"
                                    DataContext="{Binding ToolPalette}" />

    <!-- Правая колонка: свойства, история, горячие клавиши -->
    <Border DockPanel.Dock="Right"
            Width="320"
            BorderBrush="{DynamicResource ThemeBorderMidBrush}"
            BorderThickness="1,0,0,0"
            Padding="8">
      <ScrollViewer>
        <StackPanel Spacing="8">
          <views:TutorialPanel />
          <views:PropertiesPanel />
          <views:HistoryPanel />
          <views:ShortcutPanel />
          <printvolume:PrintVolumePanel />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Вкладки проектов (заготовка) + место вьюпорта -->
    <TabControl ItemsSource="{Binding Projects}"
                SelectedItem="{Binding SelectedProject}"
                Margin="8">
      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ProjectTabViewModel">
          <TextBlock Text="{Binding Title}" />
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate x:DataType="vm:ProjectTabViewModel">
          <views:ViewportView />
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>
  </DockPanel>
</Window>
