<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmetaNA.EditorUI.ViewModels"
        xmlns:views="using:SmetaNA.EditorUI.Views"
        xmlns:vcb="using:SmetaNA.EditorUI.Vcb"
        xmlns:printvolume="using:SmetaNA.EditorUI.PrintVolume"
        xmlns:toolpalette="using:SmetaNA.EditorUI.ToolPalette"
        x:Class="SmetaNA.EditorUI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Strings.AppTitle}"
        Width="1280"
        Height="800"
        KeyDown="OnWindowKeyDown">
  <DockPanel>
    <!-- Меню: быстрый доступ к основным командам (progressive disclosure) -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="{Binding Strings.MenuFile}">
        <MenuItem Header="{Binding Strings.ProjectNew}" Command="{Binding NewProjectCommand}" />
        <MenuItem Header="{Binding Strings.LicenseOpen}" Command="{Binding OpenLicenseCommand}" />
      </MenuItem>
      <MenuItem Header="{Binding Strings.MenuEdit}">
        <MenuItem Header="{Binding Strings.EditUndo}"
                  Command="{Binding UndoCommand}"
                  ToolTip.Tip="{Binding UndoHint}" />
        <MenuItem Header="{Binding Strings.EditRedo}"
                  Command="{Binding RedoCommand}"
                  ToolTip.Tip="{Binding RedoHint}" />
      </MenuItem>
      <MenuItem Header="{Binding Strings.MenuView}">
        <MenuItem Header="{Binding Strings.CommandToggleTheme}" Command="{Binding ThemeToggleCommand}" />
        <MenuItem Header="{Binding Strings.ModeLabel}" Command="{Binding ToggleModeCommand}" />
      </MenuItem>
      <MenuItem Header="{Binding Strings.MenuHelp}">
        <MenuItem Header="{Binding Strings.TutorialStart}" Command="{Binding Tutorial.StartCommand}" />
        <MenuItem Header="{Binding Strings.LicenseOpen}" Command="{Binding OpenLicenseCommand}" />
      </MenuItem>
    </Menu>

    <!-- Лента инструментов: минимум на виду, продвинутое — в раскрываемой строке -->
    <Border DockPanel.Dock="Top"
            BorderBrush="{DynamicResource ThemeBorderMidBrush}"
            BorderThickness="0,0,0,1"
            Padding="8">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="{Binding Strings.ProjectNew}"
                    Command="{Binding NewProjectCommand}" />
            <Button Content="{Binding Strings.EditUndo}"
                    Command="{Binding UndoCommand}"
                    ToolTip.Tip="{Binding UndoHint}" />
            <Button Content="{Binding Strings.EditRedo}"
                    Command="{Binding RedoCommand}"
                    ToolTip.Tip="{Binding RedoHint}" />
            <TextBlock Text="{Binding Strings.ToolbarPrimary}"
                       VerticalAlignment="Center"
                       Opacity="0.7"
                       Margin="12,0,0,0" />
            <ItemsControl ItemsSource="{Binding PrimaryTools}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ToolStubViewModel">
                  <Button Command="{Binding ActivateCommand}"
                          ToolTip.Tip="{Binding ToolTip}"
                          Classes.highlighted="{Binding IsHighlighted}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Gesture}"
                                 VerticalAlignment="Center"
                                 FontSize="11"
                                 Opacity="0.55" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ToggleButton IsChecked="{Binding IsAdvancedVisible}"
                          Content="{Binding Strings.ToolbarAdvancedToggle}"
                          VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding Strings.ModeLabel}"
                       VerticalAlignment="Center"
                       Opacity="0.7" />
            <Button Content="{Binding ModeToggleLabel}"
                    Command="{Binding ToggleModeCommand}"
                    ToolTip.Tip="{Binding Strings.ModeNoviceHint}" />
            <Button Content="{Binding Strings.TutorialStart}"
                    Command="{Binding Tutorial.StartCommand}" />
            <Button Content="{Binding Strings.LicenseOpen}"
                    Command="{Binding OpenLicenseCommand}" />
            <TextBlock Text="{Binding Strings.ThemeLabel}"
                       VerticalAlignment="Center"
                       Opacity="0.7" />
            <Button Content="{Binding ThemeToggleLabel}"
                    Command="{Binding ThemeToggleCommand}" />
            <TextBlock Text="{Binding Strings.LanguageLabel}"
                       VerticalAlignment="Center"
                       Opacity="0.7" />
            <ComboBox ItemsSource="{Binding Languages}"
                      SelectedItem="{Binding SelectedLanguage}"
                      Width="130">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LanguageOption">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Grid>
        <Border IsVisible="{Binding IsAdvancedVisible}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding Strings.ToolbarAdvanced}"
                       VerticalAlignment="Center"
                       Opacity="0.7" />
            <ItemsControl ItemsSource="{Binding AdvancedTools}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ToolStubViewModel">
                  <Button Command="{Binding ActivateCommand}"
                          ToolTip.Tip="{Binding ToolTip}"
                          Classes.highlighted="{Binding IsHighlighted}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Gesture}"
                                 VerticalAlignment="Center"
                                 FontSize="11"
                                 Opacity="0.55" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- Строка значений (VCB) и статус -->
    <Border DockPanel.Dock="Bottom"
            BorderBrush="{DynamicResource ThemeBorderMidBrush}"
            BorderThickness="0,1,0,0"
            Padding="8">
      <Grid ColumnDefinitions="Auto,*">
        <vcb:VcbControl Prompt="{Binding VcbPrompt}"
                        PlaceholderText="{Binding Strings.VcbWatermark}"
                        Kind="{Binding VcbKind}"
                        Unit="{Binding SceneUnit}"
                        IsEnabled="{Binding HasVcb}"
                        Committed="OnVcbCommitted" />
        <TextBlock Grid.Column="1"
                   Text="{Binding StatusText}"
                   VerticalAlignment="Center"
                   Margin="16,0,0,0"
                   TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <!-- Палитра инструментов (волна 0 — каркас: группы и кнопки-заглушки с жестами;
         иконки, вылеты и настройка — волна 1, треки A/B/C) -->
    <Border DockPanel.Dock="Left"
            Width="92"
            BorderBrush="{DynamicResource ThemeBorderMidBrush}"
            BorderThickness="0,0,1,0"
            Padding="6">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding PaletteGroups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="toolpalette:PaletteGroupViewModel">
              <StackPanel Spacing="4" Margin="0,0,0,8">
                <TextBlock Text="{Binding Name}"
                           FontSize="10"
                           TextAlignment="Center"
                           Opacity="0.7"
                           TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Buttons}" Width="80">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ToolStubViewModel">
                      <Button Width="38"
                              Height="38"
                              Margin="1"
                              Command="{Binding ActivateCommand}"
                              ToolTip.Tip="{Binding ToolTip}"
                              Classes.highlighted="{Binding IsHighlighted}"
                              Classes.active="{Binding IsActive}">
                        <TextBlock Text="{Binding PaletteLabel}" FontSize="11" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Правая колонка: свойства, история, горячие клавиши -->
    <Border DockPanel.Dock="Right"
            Width="320"
            BorderBrush="{DynamicResource ThemeBorderMidBrush}"
            BorderThickness="1,0,0,0"
            Padding="8">
      <ScrollViewer>
        <StackPanel Spacing="8">
          <views:TutorialPanel />
          <views:PropertiesPanel />
          <views:HistoryPanel />
          <views:ShortcutPanel />
          <printvolume:PrintVolumePanel />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Вкладки проектов (заготовка) + место вьюпорта -->
    <TabControl ItemsSource="{Binding Projects}"
                SelectedItem="{Binding SelectedProject}"
                Margin="8">
      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ProjectTabViewModel">
          <TextBlock Text="{Binding Title}" />
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate x:DataType="vm:ProjectTabViewModel">
          <views:ViewportView />
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>
  </DockPanel>
</Window>
