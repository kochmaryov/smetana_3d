<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmetaNA.EditorUI.Vcb.VcbControl">
  <UserControl.Styles>
    <Style Selector="Border.vcb">
      <Setter Property="Background" Value="{DynamicResource ThemeControlBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMidBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
      <Setter Property="Padding" Value="10,2" />
    </Style>
    <Style Selector="Border.vcb.error">
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeErrorBrush}" />
    </Style>
    <Style Selector="TextBox.vcbInput">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,2" />
    </Style>
  </UserControl.Styles>

  <Border x:Name="RootBorder" Classes="vcb">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock x:Name="PromptText"
                 VerticalAlignment="Center"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource ThemeAccentBrush}"
                 MinWidth="80" />
      <TextBox x:Name="InputBox"
               Classes="vcbInput"
               Width="160"
               KeyDown="OnInputKeyDown"
               TextChanged="OnInputTextChanged" />
      <TextBlock x:Name="UnitLabel"
                 VerticalAlignment="Center"
                 Opacity="0.6" />
      <TextBlock x:Name="ErrorText"
                 VerticalAlignment="Center"
                 MaxWidth="280"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource ThemeErrorBrush}" />
    </StackPanel>
  </Border>
</UserControl>
