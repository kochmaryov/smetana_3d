<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pv="using:SmetaNA.EditorUI.PrintVolume"
             x:Class="SmetaNA.EditorUI.PrintVolume.PrintVolumePanel"
             x:DataType="pv:PrintVolumeViewModel">
  <!-- Зона печати (каталог ui-redesign §1): профиль, параметры, тумблеры -->
  <ScrollViewer Padding="10">
    <StackPanel Spacing="8">
      <TextBlock Classes="cardTitle" Text="{Binding Title}" />
      <ComboBox Classes="field"
                ItemsSource="{Binding Profiles}"
                SelectedItem="{Binding SelectedProfile}"
                HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="pv:PrinterProfileOption">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Name}" />
              <TextBlock Classes="dim" Text="{Binding Summary}" FontSize="10" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <TextBlock Classes="dim" Text="{Binding ProfileLabel}" FontSize="11" />
          <TextBlock Grid.Column="1" Text="{Binding ProfileName}" Margin="12,0,0,0" FontSize="11" />
          <TextBlock Grid.Row="1" Classes="dim" Text="{Binding VolumeLabel}" FontSize="11" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VolumeText}" Margin="12,0,0,0" FontSize="11" />
          <TextBlock Grid.Row="2" Classes="dim" Text="{Binding NozzleLabel}" FontSize="11" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding NozzleText}" Margin="12,0,0,0" FontSize="11" />
          <TextBlock Grid.Row="3" Classes="dim" Text="{Binding LayerLabel}" FontSize="11" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LayerText}" Margin="12,0,0,0" FontSize="11" />
          <TextBlock Grid.Row="4" Classes="dim" Text="{Binding NotesLabel}" FontSize="11" />
          <TextBlock Grid.Row="4" Grid.Column="1"
                     Text="{Binding NotesText}"
                     Margin="12,0,0,0"
                     TextWrapping="Wrap"
                     FontSize="11" />
        </Grid>
      </Border>
      <CheckBox IsChecked="{Binding IsVolumeVisible}" Content="{Binding ShowVolumeLabel}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
