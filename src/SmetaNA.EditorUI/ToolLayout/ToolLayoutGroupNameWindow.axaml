<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SmetaNA.EditorUI.ToolLayout"
        xmlns:icons="using:SmetaNA.EditorUI.Icons"
        x:Class="SmetaNA.EditorUI.ToolLayout.ToolLayoutGroupNameWindow"
        x:DataType="local:ToolLayoutGroupNameViewModel"
        Title="{Binding Title}"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock Text="{Binding Label}" />
    <TextBox x:Name="NameBox" Text="{Binding Name}" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Classes="icon"
              Command="{Binding CancelCommand}"
              ToolTip.Tip="{Binding CancelText}">
        <icons:UiIcon IconId="Close" Width="18" Height="18" />
      </Button>
      <Button Classes="icon"
              Command="{Binding OkCommand}"
              ToolTip.Tip="{Binding OkText}">
        <icons:UiIcon IconId="Check" Width="18" Height="18" />
      </Button>
    </StackPanel>
  </StackPanel>
</Window>
