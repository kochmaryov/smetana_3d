<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SmetaNA.EditorUI.ToolLayout"
        x:Class="SmetaNA.EditorUI.ToolLayout.ToolLayoutGroupNameWindow"
        x:DataType="local:ToolLayoutGroupNameViewModel"
        Title="{Binding Title}"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <!-- Название группы (спека ui-redesign T9): плотная карточка, footer-кнопки -->
  <Border Background="{DynamicResource ThemeControlBackgroundSecondary}"
          BorderBrush="{DynamicResource ThemeBorderMidBrush}"
          BorderThickness="1"
          Padding="16">
    <StackPanel Spacing="12">
      <TextBlock Text="{Binding Label}" Classes="sectionLabel" />
      <TextBox Classes="field"
               x:Name="NameBox"
               Text="{Binding Name}"
               MinWidth="300" />
      <Border Height="1" Background="{DynamicResource ThemeBorderSoftBrush}" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="{Binding CancelText}"
                Command="{Binding CancelCommand}" />
        <Button Content="{Binding OkText}"
                Command="{Binding OkCommand}"
                IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
