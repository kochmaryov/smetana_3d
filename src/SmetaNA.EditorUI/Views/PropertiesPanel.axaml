<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmetaNA.EditorUI.ViewModels"
             x:Class="SmetaNA.EditorUI.Views.PropertiesPanel"
             x:DataType="vm:MainWindowViewModel">
  <!-- Свойства (каталог ui-redesign §1): карточки «Инструмент / Выделение / Сцена» -->
  <ScrollViewer Padding="10">
    <StackPanel Spacing="8">
      <Border Classes="card">
        <StackPanel Spacing="2">
          <TextBlock Classes="cardTitle"
                     Text="{Binding Strings.PropertiesActiveTool}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding ActiveToolName}"
                       Foreground="{DynamicResource ThemeAccentBrush}"
                       FontWeight="SemiBold" />
            <Border Classes="chip"
                    Padding="6,0"
                    MinHeight="20"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding ActiveToolGesture}" FontSize="10" />
            </Border>
          </StackPanel>
          <TextBlock Classes="dim"
                     Text="{Binding ActiveToolInputName}"
                     FontSize="11" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="2">
          <TextBlock Classes="cardTitle"
                     Text="{Binding Strings.PropertiesSelection}" />
          <TextBlock Classes="dim"
                     Text="{Binding Strings.PropertiesNoSelection}"
                     FontSize="11" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="2">
          <TextBlock Classes="cardTitle"
                     Text="{Binding Strings.PropertiesScene}" />
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
            <TextBlock Classes="dim"
                       Text="{Binding Strings.PropertiesSceneUnit}"
                       FontSize="11" />
            <TextBlock Grid.Column="1"
                       Text="{Binding SceneUnitName}"
                       Margin="12,0,0,0"
                       FontSize="11" />
            <TextBlock Grid.Row="1"
                       Classes="dim"
                       Text="{Binding Strings.PropertiesSceneNodes}"
                       FontSize="11" />
            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       Text="{Binding SceneNodeCount}"
                       Margin="12,0,0,0"
                       FontSize="11" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
