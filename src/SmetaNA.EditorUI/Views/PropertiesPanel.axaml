<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmetaNA.EditorUI.ViewModels"
             x:Class="SmetaNA.EditorUI.Views.PropertiesPanel"
             x:DataType="vm:MainWindowViewModel">
  <Border BorderBrush="{DynamicResource ThemeBorderMidBrush}"
          BorderThickness="1"
          CornerRadius="4"
          Padding="12">
    <StackPanel Spacing="8">
      <TextBlock Text="{Binding Strings.PropertiesTitle}" FontWeight="SemiBold" />
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Text="{Binding Strings.PropertiesActiveTool}" Opacity="0.7" />
        <TextBlock Grid.Column="1" Text="{Binding ActiveToolName}" Margin="12,0,0,0" />
        <TextBlock Grid.Row="1" Text="{Binding Strings.PropertiesSelection}" Opacity="0.7" />
        <TextBlock Grid.Row="1" Grid.Column="1"
                   Text="{Binding Strings.PropertiesNoSelection}"
                   Margin="12,0,0,0" />
        <TextBlock Grid.Row="2" Text="{Binding Strings.PropertiesScene}" FontWeight="SemiBold" Margin="0,6,0,0" />
        <TextBlock Grid.Row="3" Text="{Binding Strings.PropertiesSceneUnit}" Opacity="0.7" />
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SceneUnitName}" Margin="12,0,0,0" />
        <TextBlock Grid.Row="4" Text="{Binding Strings.PropertiesSceneNodes}" Opacity="0.7" />
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SceneNodeCount}" Margin="12,0,0,0" />
        <TextBlock Grid.Row="5" Grid.ColumnSpan="2"
                   Text="{Binding Strings.PropertiesStubNote}"
                   Margin="0,6,0,0"
                   Opacity="0.6"
                   TextWrapping="Wrap" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
