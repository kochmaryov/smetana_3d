<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmetaNA.EditorUI.ViewModels"
             xmlns:icons="using:SmetaNA.EditorUI.Icons"
             xmlns:gl="using:SmetaNA.Rendering"
             x:Class="SmetaNA.EditorUI.Views.ViewportView"
             x:DataType="vm:ProjectTabViewModel">
  <UserControl.Styles>
    <Style Selector="Button.viewseg">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderSoftBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.viewseg:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundTertiary}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
    </Style>
    <Style Selector="Button.viewseg:first-child">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <gl:GlViewportControl x:Name="Viewport" />

    <!-- Оверлей предпросмотра инструментов (мировые координаты → пиксели камерой) -->
    <Canvas x:Name="ToolOverlay" IsHitTestVisible="False" />

    <!-- HUD одним чипом (спека ui-redesign T6): статистика, единицы, выделение.
         Панель режимов переехала в шапку окна и поверх сцены не лежит. -->
    <Border x:Name="HudPanel"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="8"
            Classes="chip">
      <StackPanel Spacing="1">
        <TextBlock x:Name="StatsText" Foreground="{DynamicResource ThemeHudStatBrush}" FontSize="11" />
        <TextBlock x:Name="UnitsText" Foreground="{DynamicResource ThemeHudInfoBrush}" FontSize="11" />
        <TextBlock x:Name="SelectionText" Foreground="{DynamicResource ThemeHudSelectionBrush}" FontSize="11" />
      </StackPanel>
    </Border>

    <!-- Стандартные виды и вписывание: сегмент-контрол внизу по центру -->
    <Border HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="8"
            Classes="chip"
            Padding="1">
      <StackPanel Orientation="Horizontal">
        <Button Classes="viewseg"
                ToolTip.Tip="{Binding Strings.ViewportViewIso}"
                Click="OnViewIso">
          <icons:UiIcon IconId="Iso" Width="15" Height="15" />
        </Button>
        <Button Classes="viewseg"
                ToolTip.Tip="{Binding Strings.ViewportViewFront}"
                Click="OnViewFront">
          <icons:UiIcon IconId="ViewFront" Width="15" Height="15" />
        </Button>
        <Button Classes="viewseg"
                ToolTip.Tip="{Binding Strings.ViewportViewBack}"
                Click="OnViewBack">
          <icons:UiIcon IconId="ViewBack" Width="15" Height="15" />
        </Button>
        <Button Classes="viewseg"
                ToolTip.Tip="{Binding Strings.ViewportViewLeft}"
                Click="OnViewLeft">
          <icons:UiIcon IconId="ViewLeft" Width="15" Height="15" />
        </Button>
        <Button Classes="viewseg"
                ToolTip.Tip="{Binding Strings.ViewportViewRight}"
                Click="OnViewRight">
          <icons:UiIcon IconId="ViewRight" Width="15" Height="15" />
        </Button>
        <Button Classes="viewseg"
                ToolTip.Tip="{Binding Strings.ViewportViewTop}"
                Click="OnViewTop">
          <icons:UiIcon IconId="ViewTop" Width="15" Height="15" />
        </Button>
        <Button Classes="viewseg"
                ToolTip.Tip="{Binding Strings.ViewportViewBottom}"
                Click="OnViewBottom">
          <icons:UiIcon IconId="ViewBottom" Width="15" Height="15" />
        </Button>
        <Button Classes="viewseg"
                ToolTip.Tip="{Binding Strings.ViewportZoomExtents}"
                Click="OnZoomExtents">
          <icons:UiIcon IconId="ZoomExtents" Width="15" Height="15" />
        </Button>
      </StackPanel>
    </Border>

    <!-- Контекстная полоса у курсора (T4): быстрые действия по выделению,
         появляется только при выбранном объекте и ничего не перекрывает в покое. -->
    <Popup x:Name="CursorStrip"
           Placement="Pointer"
           HorizontalOffset="12"
           VerticalOffset="12"
           IsLightDismissEnabled="True"
           OverlayDismissEventPassThrough="True">
      <Border Classes="chip"
              Padding="2">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Classes="ibtn"
                  Tag="tool.pushpull"
                  Click="OnCursorStripTool"
                  ToolTip.Tip="{Binding Strings.ToolPushPull}">
            <icons:ToolIcon IconId="PushPull" Width="15" Height="15" />
          </Button>
          <Button Classes="ibtn"
                  Tag="tool.move"
                  Click="OnCursorStripTool"
                  ToolTip.Tip="{Binding Strings.ToolMove}">
            <icons:ToolIcon IconId="Move" Width="15" Height="15" />
          </Button>
          <Button Classes="ibtn"
                  Tag="tool.scale"
                  Click="OnCursorStripTool"
                  ToolTip.Tip="{Binding Strings.ToolScale}">
            <icons:ToolIcon IconId="Scale" Width="15" Height="15" />
          </Button>
          <Button Classes="ibtn"
                  Tag="tool.paint"
                  Click="OnCursorStripTool"
                  ToolTip.Tip="{Binding Strings.ToolPaintBucket}">
            <icons:ToolIcon IconId="Paint" Width="15" Height="15" />
          </Button>
        </StackPanel>
      </Border>
    </Popup>

  </Grid>
</UserControl>
