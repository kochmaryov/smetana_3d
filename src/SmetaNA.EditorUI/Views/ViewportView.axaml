<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmetaNA.EditorUI.ViewModels"
             xmlns:icons="using:SmetaNA.EditorUI.Icons"
             xmlns:gl="using:SmetaNA.Rendering"
             x:Class="SmetaNA.EditorUI.Views.ViewportView"
             x:DataType="vm:ProjectTabViewModel">
  <Grid>
    <gl:GlViewportControl x:Name="Viewport" />

    <!-- Оверлей предпросмотра инструментов (мировые координаты → пиксели камерой) -->
    <Canvas x:Name="ToolOverlay" IsHitTestVisible="False" />

    <!-- Панель режимов: отображение, проекция, сетка/оси, единицы.
         Три состояния по ширине вьюпорта: полное ≥760, компакт 600–760 (только
         кнопки, подписи в тултипах), «⚙» <600 (панель свёрнута, кнопка
         раскрывает её). Один набор контролов — без дублей и рассинхрона. -->
    <Border x:Name="ViewModePanel"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="8"
            Padding="10,6"
            CornerRadius="6"
            Background="#B0000000">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock x:Name="ModeLabel"
                   Text="{Binding Strings.ViewportModeLabel}"
                   VerticalAlignment="Center"
                   Foreground="#E0E0E0" />
        <ComboBox x:Name="ModeSelector"
                  ItemsSource="{Binding RenderModes}"
                  SelectedItem="{Binding SelectedRenderMode}"
                  SelectionChanged="OnRenderModeChanged"
                  Width="120"
                  ToolTip.Tip="{Binding Strings.ViewportModeLabel}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RenderModeOption">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock x:Name="ProjectionLabel"
                   Text="{Binding Strings.ViewportProjectionLabel}"
                   VerticalAlignment="Center"
                   Foreground="#E0E0E0" />
        <ToggleButton x:Name="OrthoToggle"
                      Classes="icon"
                      ToolTip.Tip="{Binding Strings.ViewportProjectionOrtho}"
                      Click="OnProjectionToggle">
          <icons:UiIcon IconId="Ortho" Width="18" Height="18" />
        </ToggleButton>
        <ToggleButton x:Name="GridToggle"
                      Classes="icon"
                      IsChecked="True"
                      ToolTip.Tip="{Binding Strings.ViewportShowGrid}"
                      Click="OnGridToggle">
          <icons:UiIcon IconId="Grid" Width="18" Height="18" />
        </ToggleButton>
        <ToggleButton x:Name="AxesToggle"
                      Classes="icon"
                      IsChecked="True"
                      ToolTip.Tip="{Binding Strings.ViewportShowAxes}"
                      Click="OnAxesToggle">
          <icons:UiIcon IconId="Axes" Width="18" Height="18" />
        </ToggleButton>
        <TextBlock x:Name="UnitLabel"
                   Text="{Binding Strings.ViewportUnitLabel}"
                   VerticalAlignment="Center"
                   Foreground="#E0E0E0" />
        <ComboBox x:Name="UnitSelector"
                  ItemsSource="{Binding Units}"
                  SelectedItem="{Binding SelectedUnit}"
                  SelectionChanged="OnUnitChanged"
                  Width="110"
                  ToolTip.Tip="{Binding Strings.ViewportUnitLabel}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:UnitOption">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </Border>

    <!-- Компактная кнопка «⚙» (<600 px): раскрывает/прячет панель режимов -->
    <Button x:Name="ViewModeGearButton"
            Classes="icon"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="8"
            IsVisible="False"
            ToolTip.Tip="{Binding Strings.ViewportModeLabel}"
            Click="OnViewModeGearClick">
      <icons:UiIcon IconId="Gear" Width="18" Height="18" />
    </Button>

    <!-- HUD: статистика, единицы, выделение -->
    <Border HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="8"
            Padding="10,6"
            CornerRadius="6"
            Background="#B0000000">
      <StackPanel Spacing="2">
        <TextBlock x:Name="StatsText" Foreground="#7CFC98" />
        <TextBlock x:Name="UnitsText" Foreground="#D0D0D0" />
        <TextBlock x:Name="SelectionText" Foreground="#F0C060" />
      </StackPanel>
    </Border>

    <!-- Стандартные виды и вписывание (кнопки-иконки: узкая панель без
         горизонтального переполнения на малых вьюпортах) -->
    <Border HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="8"
            Padding="10,6"
            CornerRadius="6"
            Background="#B0000000">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Classes="icon"
                ToolTip.Tip="{Binding Strings.ViewportViewIso}"
                Click="OnViewIso">
          <icons:UiIcon IconId="Iso" Width="18" Height="18" />
        </Button>
        <Button Classes="icon"
                ToolTip.Tip="{Binding Strings.ViewportViewFront}"
                Click="OnViewFront">
          <icons:UiIcon IconId="ViewFront" Width="18" Height="18" />
        </Button>
        <Button Classes="icon"
                ToolTip.Tip="{Binding Strings.ViewportViewBack}"
                Click="OnViewBack">
          <icons:UiIcon IconId="ViewBack" Width="18" Height="18" />
        </Button>
        <Button Classes="icon"
                ToolTip.Tip="{Binding Strings.ViewportViewLeft}"
                Click="OnViewLeft">
          <icons:UiIcon IconId="ViewLeft" Width="18" Height="18" />
        </Button>
        <Button Classes="icon"
                ToolTip.Tip="{Binding Strings.ViewportViewRight}"
                Click="OnViewRight">
          <icons:UiIcon IconId="ViewRight" Width="18" Height="18" />
        </Button>
        <Button Classes="icon"
                ToolTip.Tip="{Binding Strings.ViewportViewTop}"
                Click="OnViewTop">
          <icons:UiIcon IconId="ViewTop" Width="18" Height="18" />
        </Button>
        <Button Classes="icon"
                ToolTip.Tip="{Binding Strings.ViewportViewBottom}"
                Click="OnViewBottom">
          <icons:UiIcon IconId="ViewBottom" Width="18" Height="18" />
        </Button>
        <Button Classes="icon"
                ToolTip.Tip="{Binding Strings.ViewportZoomExtents}"
                Click="OnZoomExtents">
          <icons:UiIcon IconId="ZoomExtents" Width="18" Height="18" />
        </Button>
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
