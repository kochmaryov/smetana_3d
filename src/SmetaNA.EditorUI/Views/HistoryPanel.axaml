<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmetaNA.EditorUI.ViewModels"
             x:Class="SmetaNA.EditorUI.Views.HistoryPanel"
             x:DataType="vm:MainWindowViewModel">
  <!-- История (каталог ui-redesign §1): нумерованный лог с акцентом текущего шага -->
  <ScrollViewer Padding="10">
    <StackPanel Spacing="8">
      <TextBlock Classes="cardTitle"
                 Text="{Binding Strings.HistoryTitle}" />
      <TextBlock Classes="dim"
                 Text="{Binding Strings.HistoryEmpty}"
                 IsVisible="{Binding IsHistoryEmpty}"
                 FontSize="11" />
      <ItemsControl ItemsSource="{Binding HistoryEntries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HistoryEntryViewModel">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,1">
              <Ellipse Width="6"
                       Height="6"
                       VerticalAlignment="Center"
                       Fill="{DynamicResource ThemeAccentBrush}"
                       IsVisible="{Binding IsCurrent}" />
              <TextBlock Grid.Column="1"
                         Classes="dim"
                         FontSize="11"
                         VerticalAlignment="Center"
                         Margin="8,0,6,0"
                         Text="{Binding Description}" />
              <TextBlock Grid.Column="3"
                         Classes="dim"
                         Text="{Binding CurrentLabel}"
                         IsVisible="{Binding IsCurrent}"
                         FontSize="10"
                         VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
