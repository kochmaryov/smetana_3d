<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmetaNA.EditorUI.ViewModels"
             x:Class="SmetaNA.EditorUI.Views.HistoryPanel"
             x:DataType="vm:MainWindowViewModel">
  <Border BorderBrush="{DynamicResource ThemeBorderMidBrush}"
          BorderThickness="1"
          CornerRadius="4"
          Padding="12">
    <StackPanel Spacing="8">
      <TextBlock Text="{Binding Strings.HistoryTitle}" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Strings.HistoryEmpty}"
                 IsVisible="{Binding IsHistoryEmpty}"
                 Opacity="0.7" />
      <ItemsControl ItemsSource="{Binding HistoryEntries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HistoryEntryViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
              <Ellipse Width="7"
                       Height="7"
                       VerticalAlignment="Center"
                       Fill="{DynamicResource ThemeAccentBrush}"
                       IsVisible="{Binding IsCurrent}" />
              <TextBlock Grid.Column="1"
                         Text="{Binding Description}"
                         TextWrapping="Wrap"
                         Margin="8,0,0,0" />
              <TextBlock Grid.Column="2"
                         Text="{Binding CurrentLabel}"
                         IsVisible="{Binding IsCurrent}"
                         Margin="8,0,0,0"
                         Opacity="0.6" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
