<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmetaNA.EditorUI.ViewModels"
             xmlns:icons="using:SmetaNA.EditorUI.Icons"
             x:Class="SmetaNA.EditorUI.Views.TutorialPanel"
             x:DataType="vm:MainWindowViewModel">
  <!-- Урок (каталог ui-redesign §1): прогресс, текущий шаг, управление -->
  <ScrollViewer Padding="10">
    <StackPanel Spacing="8">
      <TextBlock Classes="cardTitle"
                 Text="{Binding Tutorial.Title}" />
      <TextBlock Classes="dim"
                 Text="{Binding Tutorial.Intro}"
                 TextWrapping="Wrap"
                 FontSize="11" />
      <TextBlock Text="{Binding Tutorial.ProgressText}"
                FontWeight="SemiBold"
                FontSize="11" />
      <Border Classes="card"
              BorderBrush="{DynamicResource ThemeAccentBrush}">
        <TextBlock Text="{Binding Tutorial.CurrentStepText}"
                   TextWrapping="Wrap"
                   FontSize="11" />
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Classes="ibtn"
                Command="{Binding Tutorial.StartCommand}"
                IsVisible="{Binding !Tutorial.IsActive}"
                ToolTip.Tip="{Binding Strings.TutorialStart}">
          <icons:UiIcon IconId="Play" Width="16" Height="16" />
        </Button>
        <Button Classes="ibtn"
                Command="{Binding Tutorial.BackCommand}"
                IsVisible="{Binding Tutorial.IsActive}"
                ToolTip.Tip="{Binding Strings.TutorialBack}">
          <icons:UiIcon IconId="ChevronLeft" Width="16" Height="16" />
        </Button>
        <Button Classes="ibtn"
                Command="{Binding Tutorial.NextCommand}"
                IsVisible="{Binding Tutorial.IsActive}"
                ToolTip.Tip="{Binding Strings.TutorialNext}">
          <icons:UiIcon IconId="ChevronRight" Width="16" Height="16" />
        </Button>
        <Button Classes="ibtn"
                Command="{Binding Tutorial.RestartCommand}"
                IsVisible="{Binding Tutorial.IsActive}"
                ToolTip.Tip="{Binding Strings.TutorialRestart}">
          <icons:UiIcon IconId="Restart" Width="16" Height="16" />
        </Button>
        <Button Classes="ibtn"
                Command="{Binding Tutorial.CloseCommand}"
                IsVisible="{Binding Tutorial.IsActive}"
                ToolTip.Tip="{Binding Strings.TutorialClose}">
          <icons:UiIcon IconId="Close" Width="16" Height="16" />
        </Button>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>