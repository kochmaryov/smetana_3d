<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmetaNA.EditorUI.ViewModels"
             xmlns:icons="using:SmetaNA.EditorUI.Icons"
             x:Class="SmetaNA.EditorUI.Views.TutorialPanel"
             x:DataType="vm:MainWindowViewModel">
  <Border BorderBrush="{DynamicResource ThemeBorderMidBrush}"
          BorderThickness="1"
          CornerRadius="4"
          Padding="12"
          IsVisible="{Binding IsTutorialVisible}">
    <StackPanel Spacing="8">
      <TextBlock Text="{Binding Tutorial.Title}" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Tutorial.Intro}"
                 Opacity="0.7"
                 TextWrapping="Wrap" />
      <TextBlock Text="{Binding Tutorial.ProgressText}"
                 FontWeight="SemiBold" />
      <TextBlock Text="{Binding Tutorial.CurrentStepText}"
                 TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Classes="icon"
                Command="{Binding Tutorial.StartCommand}"
                IsVisible="{Binding !Tutorial.IsActive}"
                ToolTip.Tip="{Binding Strings.TutorialStart}">
          <icons:UiIcon IconId="Play" Width="18" Height="18" />
        </Button>
        <Button Classes="icon"
                Command="{Binding Tutorial.BackCommand}"
                IsVisible="{Binding Tutorial.IsActive}"
                ToolTip.Tip="{Binding Strings.TutorialBack}">
          <icons:UiIcon IconId="ChevronLeft" Width="18" Height="18" />
        </Button>
        <Button Classes="icon"
                Command="{Binding Tutorial.NextCommand}"
                IsVisible="{Binding Tutorial.IsActive}"
                ToolTip.Tip="{Binding Strings.TutorialNext}">
          <icons:UiIcon IconId="ChevronRight" Width="18" Height="18" />
        </Button>
        <Button Classes="icon"
                Command="{Binding Tutorial.RestartCommand}"
                IsVisible="{Binding Tutorial.IsActive}"
                ToolTip.Tip="{Binding Strings.TutorialRestart}">
          <icons:UiIcon IconId="Restart" Width="18" Height="18" />
        </Button>
        <Button Classes="icon"
                Command="{Binding Tutorial.CloseCommand}"
                IsVisible="{Binding Tutorial.IsActive}"
                ToolTip.Tip="{Binding Strings.TutorialClose}">
          <icons:UiIcon IconId="Close" Width="18" Height="18" />
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
