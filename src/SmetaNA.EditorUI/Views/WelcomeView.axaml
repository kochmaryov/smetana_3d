<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmetaNA.EditorUI.ViewModels"
             xmlns:icons="using:SmetaNA.EditorUI.Icons"
             x:Class="SmetaNA.EditorUI.Views.WelcomeView"
             x:DataType="vm:MainWindowViewModel">
  <!-- Стартовый экран (спека ui-redesign T8): асимметричный split «hero ↔ списки»:
       слева ценность, CTA и шаблоны единиц; справа недавние файлы и урок.
       Все строки — привязки к каталогу локализации (аудит DoD §5.7). -->
  <UserControl.Styles>
    <Style Selector="Button.cta">
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    </Style>
    <Style Selector="Button.cta:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
      <Setter Property="Opacity" Value="0.88" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    </Style>
    <Style Selector="Button.unit">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    </Style>
    <Style Selector="Button.recent">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.recent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundTertiary}" />
    </Style>
    <Style Selector="Button.lesson">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
      <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource ThemeBackgroundBrush}">
    <Grid ColumnDefinitions="3*,2*"
          MaxWidth="1180"
          Margin="40,28">
      <!-- Hero: ценность, CTA и шаблоны единиц -->
      <StackPanel VerticalAlignment="Center"
                  Spacing="20"
                  Margin="0,0,36,0">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding Strings.AppTitle}"
                     FontSize="30"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding Strings.WelcomeSubtitle}"
                     Classes="dim"
                     FontSize="14"
                     TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="cta"
                  Command="{Binding NewProjectCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <icons:UiIcon IconId="New" Width="17" Height="17" />
              <TextBlock Text="{Binding Strings.ProjectNew}" />
            </StackPanel>
          </Button>
          <Button Classes="secondary"
                  Command="{Binding OpenFileCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <icons:UiIcon IconId="Import" Width="17" Height="17" />
              <TextBlock Text="{Binding Strings.ProjectOpen}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Шаблоны: единицы измерения нового проекта -->
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Strings.WelcomeTemplates}" Classes="sectionLabel" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Classes="unit"
                    Command="{Binding CreateProjectWithUnitCommand}"
                    CommandParameter="Millimeter">
              <TextBlock Text="{Binding Strings.UnitMillimeter}" />
            </Button>
            <Button Classes="unit"
                    Command="{Binding CreateProjectWithUnitCommand}"
                    CommandParameter="Centimeter">
              <TextBlock Text="{Binding Strings.UnitCentimeter}" />
            </Button>
            <Button Classes="unit"
                    Command="{Binding CreateProjectWithUnitCommand}"
                    CommandParameter="Meter">
              <TextBlock Text="{Binding Strings.UnitMeter}" />
            </Button>
            <Button Classes="unit"
                    Command="{Binding CreateProjectWithUnitCommand}"
                    CommandParameter="Inch">
              <TextBlock Text="{Binding Strings.UnitInch}" />
            </Button>
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <!-- Списки: недавние файлы и урок -->
      <StackPanel Grid.Column="1"
                  VerticalAlignment="Center"
                  Spacing="12">
        <Border Classes="card" Padding="12">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding Strings.WelcomeRecent}" Classes="cardTitle" />
            <TextBlock Text="{Binding Strings.WelcomeRecentEmpty}"
                       Classes="dim"
                       IsVisible="{Binding !HasRecentFiles}"
                       TextWrapping="Wrap" />
            <ScrollViewer MaxHeight="236">
              <ItemsControl ItemsSource="{Binding RecentFiles}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RecentFileViewModel">
                    <Button Classes="recent"
                            Command="{Binding OpenCommand}"
                            ToolTip.Tip="{Binding FullPath}">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="12">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <icons:UiIcon IconId="Book" Width="16" Height="16" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Strings.TutorialTitle}"
                         Classes="cardTitle"
                         VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Strings.TutorialS1Intro}"
                       Classes="dim"
                       FontSize="11"
                       TextWrapping="Wrap" />
            <Button Classes="lesson"
                    HorizontalAlignment="Left"
                    Command="{Binding Tutorial.StartCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <icons:UiIcon IconId="Play" Width="15" Height="15" />
                <TextBlock Text="{Binding Strings.TutorialStart}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
