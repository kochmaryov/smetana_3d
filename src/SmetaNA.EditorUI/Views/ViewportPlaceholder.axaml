<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmetaNA.EditorUI.ViewModels"
             x:Class="SmetaNA.EditorUI.Views.ViewportPlaceholder"
             x:DataType="vm:MainWindowViewModel">
  <Border Background="{DynamicResource ThemeBackgroundBrush}"
          BorderBrush="{DynamicResource ThemeBorderMidBrush}"
          BorderThickness="1"
          CornerRadius="4"
          Padding="24">
    <StackPanel Spacing="10"
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
      <TextBlock Text="{Binding Strings.ViewportTitle}"
                 FontSize="20"
                 FontWeight="SemiBold"
                 HorizontalAlignment="Center" />
      <TextBlock Text="{Binding Strings.ViewportPlaceholder}"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 HorizontalAlignment="Center" />
      <TextBlock Text="{Binding Strings.ViewportPlaceholderHint}"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 HorizontalAlignment="Center"
                 Opacity="0.6" />
    </StackPanel>
  </Border>
</UserControl>
