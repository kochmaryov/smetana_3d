<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tp="using:SmetaNA.EditorUI.ToolPalette"
             xmlns:icons="using:SmetaNA.EditorUI.Icons"
             x:Class="SmetaNA.EditorUI.FloatingGroups.ToolButtonsPanel"
             x:DataType="tp:ToolPaletteGroupViewModel">
  <!-- Сетка кнопок группы (38×38 + метка вылета) — общий вид для палитры,
       плавающих окон и краевых лотков (спека ui-redesign T3). Стили кнопки,
       уголка вылета и пункта вылета — общие, в App.axaml. -->
  <ItemsControl ItemsSource="{Binding Buttons}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <WrapPanel ItemWidth="40"
                   ItemHeight="40"
                   HorizontalAlignment="Center" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="tp:ToolPaletteButtonViewModel">
        <Grid Classes="toolCell"
              Width="40"
              Height="40">
          <Button Classes="tool"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Command="{Binding ActivateCommand}"
                  ToolTip.Tip="{Binding ToolTip}"
                  Classes.active="{Binding IsActive}"
                  Classes.highlighted="{Binding IsHighlighted}">
            <icons:ToolIcon IconId="{Binding IconId}"
                            Width="20"
                            Height="20" />
          </Button>
          <Button Classes="flyoutCorner"
                  IsVisible="{Binding HasFlyout}"
                  Command="{Binding OpenFlyoutCommand}"
                  ToolTip.Tip="{Binding ToolTip}">
            <Path Classes="flyMark"
                  Data="M 6,0 L 6,6 L 0,6 Z"
                  Width="5"
                  Height="5"
                  Stretch="Uniform"
                  Margin="0,0,3,3" />
          </Button>
          <Popup IsOpen="{Binding IsFlyoutOpen, Mode=TwoWay}"
                 Placement="RightEdgeAlignedTop"
                 IsLightDismissEnabled="True">
            <FlyoutPresenter Padding="6"
                             MinWidth="200">
              <ItemsControl ItemsSource="{Binding FlyoutItems}" MinWidth="180">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="tp:ToolPaletteButtonViewModel">
                    <Button Classes="flyRow"
                            Command="{Binding ActivateCommand}"
                            ToolTip.Tip="{Binding ToolTip}"
                            Classes.active="{Binding IsActive}"
                            Classes.highlighted="{Binding IsHighlighted}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <icons:ToolIcon IconId="{Binding IconId}"
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Gesture}"
                                   FontSize="11"
                                   Opacity="0.55"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </FlyoutPresenter>
          </Popup>
        </Grid>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
