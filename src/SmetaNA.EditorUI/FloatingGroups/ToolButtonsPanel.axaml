<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tp="using:SmetaNA.EditorUI.ToolPalette"
             xmlns:icons="using:SmetaNA.EditorUI.Icons"
             x:Class="SmetaNA.EditorUI.FloatingGroups.ToolButtonsPanel"
             x:DataType="tp:ToolPaletteGroupViewModel">
  <!-- Сетка кнопок группы (38×38 + вылеты) — общий вид для палитры,
       плавающих окон и краевых лотков (спека ui-redesign T3). -->
  <UserControl.Styles>
    <Style Selector="Button.tool">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.flyoutCorner">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="ZIndex" Value="1" />
    </Style>
    <Style Selector="Button.flyRow">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </UserControl.Styles>

  <ItemsControl ItemsSource="{Binding Buttons}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <WrapPanel ItemWidth="40" ItemHeight="40" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="tp:ToolPaletteButtonViewModel">
        <Grid Width="38" Height="38" Margin="1">
          <Button Classes="tool"
                  Command="{Binding ActivateCommand}"
                  ToolTip.Tip="{Binding ToolTip}"
                  Classes.active="{Binding IsActive}"
                  Classes.highlighted="{Binding IsHighlighted}">
            <icons:ToolIcon IconId="{Binding IconId}"
                            Width="20"
                            Height="20" />
          </Button>
          <Button Classes="flyoutCorner"
                  IsVisible="{Binding HasFlyout}"
                  Command="{Binding OpenFlyoutCommand}"
                  ToolTip.Tip="{Binding ToolTip}">
            <Path Data="M 0,0 L 6,0 L 3,4 Z"
                  Fill="{Binding $parent[Button].Foreground}"
                  VerticalAlignment="Bottom" />
          </Button>
          <Popup IsOpen="{Binding IsFlyoutOpen, Mode=TwoWay}"
                 Placement="RightEdgeAlignedTop"
                 IsLightDismissEnabled="True">
            <FlyoutPresenter Padding="4">
              <ItemsControl ItemsSource="{Binding FlyoutItems}" MinWidth="180">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="tp:ToolPaletteButtonViewModel">
                    <Button Classes="flyRow"
                            Command="{Binding ActivateCommand}"
                            ToolTip.Tip="{Binding ToolTip}"
                            Classes.active="{Binding IsActive}"
                            Classes.highlighted="{Binding IsHighlighted}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <icons:ToolIcon IconId="{Binding IconId}"
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Gesture}"
                                   FontSize="11"
                                   Opacity="0.55"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </FlyoutPresenter>
          </Popup>
        </Grid>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
