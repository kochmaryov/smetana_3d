<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmetaNA.EditorUI.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <!-- Подсветка кнопки инструмента текущего шага урока (задача 6.2) -->
    <Style Selector="Button.highlighted">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Активная кнопка инструмента в палитре (волна 0 палитры tool-palette) -->
    <Style Selector="Button.active">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <!-- Кнопка-иконка icon-pack (главное окно, вьюпорт, панели) -->
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Application.Styles>
</Application>
