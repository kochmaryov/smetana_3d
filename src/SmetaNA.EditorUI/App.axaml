<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmetaNA.EditorUI.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SmetaNA.EditorUI/Themes/DesignTokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <!-- Подсветка кнопки инструмента текущего шага урока (задача 6.2) -->
    <Style Selector="Button.highlighted">
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeSelectionBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Активная кнопка инструмента в палитре (волна 0 палитры tool-palette).
         Рамка 1 px: толщина не меняется при выборе, кнопка не «дёргается». -->
    <Style Selector="Button.active">
      <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.tool.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
    </Style>
    <Style Selector="Button.tool.active:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
    </Style>
    <Style Selector="Button.tool.active:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
    </Style>
    <!-- Кнопка инструмента (палитра, плавающие группы, краевые лотки):
         прозрачная поверхность, скругление 7, подсветка при наведении. -->
    <Style Selector="Button.tool">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundTertiary}" />
    </Style>
    <Style Selector="Button.tool:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeControlBackground}" />
    </Style>
    <!-- Уголок вылета: метка «есть под-инструменты» в правом нижнем углу -->
    <Style Selector="Button.flyoutCorner">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
      <Setter Property="VerticalContentAlignment" Value="Bottom" />
      <Setter Property="ZIndex" Value="1" />
    </Style>
    <Style Selector="Button.flyoutCorner:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundTertiary}" />
    </Style>
    <Style Selector="Path.flyMark">
      <Setter Property="Fill" Value="{DynamicResource ThemeForegroundFaintBrush}" />
    </Style>
    <Style Selector="Grid.toolCell:pointerover Path.flyMark">
      <Setter Property="Fill" Value="{DynamicResource ThemeForegroundDimBrush}" />
    </Style>
    <!-- Пункт вылета: иконка + имя + жест -->
    <Style Selector="Button.flyRow">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.flyRow:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundTertiary}" />
    </Style>
    <!-- Кнопка-иконка icon-pack (главное окно, вьюпорт, панели) -->
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Кнопка-иконка компактная (шапка, панели у курсора) -->
    <Style Selector="Button.ibtn">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundDimBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ibtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundTertiary}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
    </Style>
    <Style Selector="Button.ibtn:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundSecondary}" />
    </Style>
    <!-- Карточка контента (панели дока, Welcome) -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundSecondary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <!-- Чип статуса/HUD -->
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource ThemeControlBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMidBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <!-- Поле ввода (VCB, диалоги) -->
    <Style Selector="TextBox.field">
      <Setter Property="Background" Value="{DynamicResource ThemeControlBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMidBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    </Style>
    <!-- Метка секции (маленькая капитель) -->
    <Style Selector="TextBlock.sectionLabel">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundFaintBrush}" />
      <Setter Property="LetterSpacing" Value="0.8" />
    </Style>
    <!-- Вторичный текст -->
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundDimBrush}" />
    </Style>
    <!-- Заголовок карточки -->
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
    </Style>
  </Application.Styles>
</Application>
