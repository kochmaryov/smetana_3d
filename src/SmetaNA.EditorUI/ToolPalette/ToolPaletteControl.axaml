<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tp="using:SmetaNA.EditorUI.ToolPalette"
             xmlns:fg="using:SmetaNA.EditorUI.FloatingGroups"
             xmlns:icons="using:SmetaNA.EditorUI.Icons"
             x:Class="SmetaNA.EditorUI.ToolPalette.ToolPaletteControl"
             x:DataType="tp:ToolPaletteViewModel">
  <!-- Палитра инструментов (макет variant_a): кнопки 38×38, группы-разделы,
       вылеты по треугольнику в углу; адаптив 2 колонки / 1 колонка / рейл. -->
  <UserControl.Styles>
    <Style Selector="Button.tool">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.flyoutCorner">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="ZIndex" Value="1" />
    </Style>
    <Style Selector="Button.groupHeader">
      <Setter Property="Padding" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <!-- Ручка «⠿» отрыва группы из палитры (T3) -->
    <Style Selector="Button.grip">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button.grip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundTertiary}" />
    </Style>
    <Style Selector="Button.railGroup">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.flyRow">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Path.chevron">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform">
        <RotateTransform Angle="-90" />
      </Setter>
    </Style>
    <Style Selector="Path.chevron.expanded">
      <Setter Property="RenderTransform">
        <RotateTransform Angle="0" />
      </Setter>
    </Style>
  </UserControl.Styles>

  <Border Width="{Binding PaletteWidth}"
          BorderBrush="{DynamicResource ThemeBorderMidBrush}"
          BorderThickness="0,0,1,0"
          Padding="6">
    <Panel>
      <!-- Обычный и компактный режимы: 2 колонки → 1 колонка (≤ 960 px).
           Вертикальный скроллбар скрыт: переполнение отрабатывает свёртка групп
           (ApplyViewportHeight), а остаточный люфт не даёт полосе мелькать. -->
      <ScrollViewer x:Name="PaletteScroll"
                    IsVisible="{Binding !IsRailMode}"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Hidden">
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="tp:ToolPaletteGroupViewModel">
              <StackPanel Spacing="4" Margin="0,0,0,8"
                          IsVisible="{Binding !IsDetached}">
                <!-- Шапка группы: свёртка-аккордеон + ручка «⠿» отрыва (T3).
                     Имя — одна строка с многоточием: длинные названия не должны
                     разворачиваться в «большие надписи» и съедать рабочее место. -->
                <Grid>
                  <Button Classes="groupHeader"
                          Classes.expanded="{Binding IsExpanded}"
                          Command="{Binding ToggleExpandedCommand}"
                          ToolTip.Tip="{Binding Name}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Path Classes="chevron"
                            Classes.expanded="{Binding IsExpanded}"
                            Data="M 0,0 L 4,4 L 8,0"
                            Stroke="{Binding $parent[Button].Foreground}"
                            StrokeThickness="1.5"
                            VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}"
                                 FontSize="10"
                                 FontWeight="SemiBold"
                                 Opacity="0.7"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Classes="grip"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Command="{Binding DetachCommand}"
                          ToolTip.Tip="{Binding DetachHint}">
                    <Path Data="M0,0 h2 v2 h-2 z M4,0 h2 v2 h-2 z M0,4 h2 v2 h-2 z M4,4 h2 v2 h-2 z"
                          Fill="{Binding $parent[Button].Foreground}"
                          Width="6"
                          Height="6"
                          Stretch="Uniform" />
                  </Button>
                </Grid>
                <fg:ToolButtonsPanel DataContext="{Binding}"
                                     IsVisible="{Binding IsExpanded}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Режим рейла (≤ 768 px): группы-кнопки с вылетами инструментов -->
      <ScrollViewer IsVisible="{Binding IsRailMode}"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Hidden">
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemWidth="46" ItemHeight="40" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="tp:ToolPaletteGroupViewModel">
              <Grid Width="44" Height="38" Margin="1">
                <Button Classes="railGroup"
                        Command="{Binding OpenFlyoutCommand}"
                        ToolTip.Tip="{Binding Name}">
                  <icons:ToolIcon IconId="{Binding LeadIconId}"
                                   Width="20"
                                   Height="20" />
                </Button>
                <Popup IsOpen="{Binding IsFlyoutOpen, Mode=TwoWay}"
                       Placement="RightEdgeAlignedTop"
                       IsLightDismissEnabled="True">
                  <FlyoutPresenter Padding="6">
                    <StackPanel MinWidth="190" Spacing="2">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="10"
                                 Opacity="0.7"
                                 Margin="4,2" />
                      <ItemsControl ItemsSource="{Binding RailItems}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="tp:ToolPaletteButtonViewModel">
                            <Button Classes="flyRow"
                                    Command="{Binding ActivateCommand}"
                                    ToolTip.Tip="{Binding ToolTip}"
                                    Classes.active="{Binding IsActive}"
                                    Classes.highlighted="{Binding IsHighlighted}">
                              <Grid ColumnDefinitions="Auto,*,Auto">
                                <icons:ToolIcon IconId="{Binding IconId}"
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Gesture}"
                                           FontSize="11"
                                           Opacity="0.55"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </FlyoutPresenter>
                </Popup>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </Border>
</UserControl>
