<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cp="using:SmetaNA.EditorUI.CommandPalette"
        x:Class="SmetaNA.EditorUI.CommandPalette.CommandPaletteWindow"
        x:DataType="cp:CommandPaletteViewModel"
        Title="{Binding Title}"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <!-- Палитра команд (Ctrl+K, макет variant_c): поиск по имени, жесты в
       строках, Enter запускает выбранную команду. -->
  <Border Background="{DynamicResource ThemeControlBackgroundSecondary}"
          BorderBrush="{DynamicResource ThemeBorderMidBrush}"
          BorderThickness="1"
          Padding="10">
    <DockPanel>
      <TextBox Classes="field"
               DockPanel.Dock="Top"
               Text="{Binding Query, Mode=TwoWay}"
               PlaceholderText="{Binding Placeholder}"
               x:Name="SearchBox" />
      <ListBox ItemsSource="{Binding Results}"
               SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
               Background="Transparent"
               BorderThickness="0"
               MaxHeight="320"
               DoubleTapped="OnResultDoubleTapped">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="cp:CommandPaletteItemViewModel">
            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
              <TextBlock Text="{Binding Name}"
                         FontSize="12"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="{Binding Gesture}"
                         FontSize="11"
                         Opacity="0.6"
                         Margin="12,0,0,0"
                         VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Border>
</Window>
