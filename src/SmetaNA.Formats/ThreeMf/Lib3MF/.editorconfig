# Официальный автогенеренный C#-биндинг lib3mf (BSD-2-Clause, 3MF Consortium):
# файл поставляется SDK как есть и не правится вручную, поэтому диагностика
# для него отключена (общий стиль проекта к автогенеренному коду не применяется).
root = false

[Lib3MF.cs]
dotnet_analyzer_diagnostic.severity = none
dotnet_diagnostic.CS0108.severity = none
dotnet_diagnostic.CS8600.severity = none
dotnet_diagnostic.CS8603.severity = none
